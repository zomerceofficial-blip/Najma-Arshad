# GEMINI_API_KEY: Required for Gemini AI API calls if server-side AI features are enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted (automatically injected in AI Studio / Vercel).
APP_URL="MY_APP_URL"

# TRUVORNEX_SESSION_SECRET: 32+ char HMAC signing key for workspace session tokens (required for Vercel production).
TRUVORNEX_SESSION_SECRET=""

# SUPABASE_AUTH: Optional Supabase project URL & anon key to enable Supabase Auth alongside Firebase Auth.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
SUPABASE_URL=""
SUPABASE_ANON_KEY=""

# TRUVORNEX_ALLOW_AUTO_JOIN: Keep "false" so only the 8 accounts provisioned by the Workspace Owner in Firebase Auth / Supabase can sign in.
TRUVORNEX_ALLOW_AUTO_JOIN="false"

# TRUVORNEX_ALLOWLIST_EMAILS: Optional comma-separated list of up to 8 pre-created Firebase/Supabase account emails allowed to claim an open slot.
TRUVORNEX_ALLOWLIST_EMAILS=""

# TRUVORNEX_KEYFILE_SECRET / TRUVORNEX_ACCESS_KEY_SHA256: Optional master JSON keyfile secret or SHA-256 hex digest required after login.
TRUVORNEX_KEYFILE_SECRET=""
TRUVORNEX_ACCESS_KEY_SHA256=""
